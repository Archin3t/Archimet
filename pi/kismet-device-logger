def credentials():
    conf = dict(line.strip().split("=", 1) for line in CREDS.read_text().splitlines()
                if "=" in line and not line.lstrip().startswith("#"))
    raw = f"{conf['httpd_username']}:{conf['httpd_password']}".encode()
    return "Basic " + base64.b64encode(raw).decode()


def refresh_credentials(current):
    """Follow Kismet password changes without restarting the long-running logger.

    Kismet writes its per-user credential file when /session/set_password succeeds.  Keep the
    last working credential during an atomic replacement, and retry on the next poll.  Never
    log either value.
    """
    try:
        fresh = credentials()
    except (OSError, KeyError, ValueError):
        return current
    if fresh != current:
        Api.auth = fresh
    return fresh


def post_json(auth, path, obj, timeout=60):
    body = "json=" + json.dumps(obj)
    req = urllib.request.Request(
        f"{API}{path}", data=body.encode(),
        headers={"Authorization": auth, "Content-Type": "application/x-www-form-urlencoded"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def fetch(auth, since):
    return post_json(auth, f"/devices/last-time/{int(since)}/devices.json", {"fields": FIELDS})


def fetch_mac(auth, mac):
    try:
        devs = post_json(auth, f"/devices/by-mac/{mac}/devices.json", {"fields": FIELDS}, timeout=20)
    except (urllib.error.URLError, OSError, ValueError):
        return None
    found = merge_by_mac([d for d in (parse(dev) for dev in devs or []) if d["mac"] == mac])
    return found[0] if found else None


KISMET_COOKIE_RE = re.compile(r"(?:^|;\s*)KISMET=([A-Za-z0-9._~+/=-]{8,256})(?:;|$)")


def kismet_auth_ok(header, cookie=False):
    """True if Kismet accepts this credential: an Authorization header, or (cookie=True) the
    browser's KISMET session cookie value. None if Kismet is down."""
    hdr = {"Cookie": f"KISMET={header}"} if cookie else {"Authorization": header}
    req = urllib.request.Request(f"{API}/session/check_session", headers=hdr)
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            return r.status == 200
    except urllib.error.HTTPError as e:
        with e:
            return False if e.code in (401, 403) else None
    except (urllib.error.URLError, OSError):
        return None


# --------------------------------------------------------------------------
# HTTP API for the plugin (port 2502)

class Api(BaseHTTPRequestHandler):
    logs = None
    status = None
    auth = ""
    protocol_version = "HTTP/1.1"
    _ok_cache = {}
    metrics = None
    sampler = None

    def log_message(self, fmt, *args):
        pass

    def _origin(self):
        """The Origin to echo, '' if none was sent, or None if it is not allowed.

        Never the raw header: urlsplit() silently drops CR / LF / TAB before parsing, so a value that
        passes the host check could still carry a line break into the response (header injection). Any
        control character or unexpected shape is refused, and only the rebuilt scheme://host[:port] is
        echoed."""
        origin = self.headers.get("Origin")
        if not origin:
            return ""
        if not ORIGIN_RE.fullmatch(origin):
            return None
        try:
            o = urllib.parse.urlsplit(origin)
            host = urllib.parse.urlsplit("//" + (self.headers.get("Host") or "")).hostname
            port = o.port
        except ValueError:
            return None
        if o.scheme in ("http", "https") and o.hostname and host and o.hostname == host:
            h = f"[{o.hostname}]" if ":" in o.hostname else o.hostname
            return f"{o.scheme}://{h}" + (f":{port}" if port else "")
        return None

    def _send(self, code, obj, origin=""):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        if origin:
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Access-Control-Allow-Credentials", "true")
            self.send_header("Vary", "Origin")
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self):
        """Kismet decides: either HTTP Basic (scripts) or the browser's own Kismet session
        cookie (the Archimet UI). The logger keeps no accounts of its own."""
        h = self.headers.get("Authorization") or ""
        m = KISMET_COOKIE_RE.search(self.headers.get("Cookie") or "")
        if h.startswith("Basic ") and len(h) <= 1024:
            cred, as_cookie = h, False
        elif m:
            cred, as_cookie = m.group(1), True
        else:
            return False
        key = hashlib.sha256((("c:" if as_cookie else "b:") + cred).encode()).hexdigest()
        hit = self._ok_cache.get(key)
        if hit and hit > time.time():
            return True
        ok = kismet_auth_ok(cred, cookie=as_cookie)
        if ok is None:
            raise ConnectionError("kismet unavailable")
        if ok:
            if len(self._ok_cache) > 64:
                self._ok_cache.clear()
            self._ok_cache[key] = time.time() + 60
        return ok

    def do_OPTIONS(self):
        origin = self._origin()
        if not origin:
            return self._send(403, {"error": "origin not allowed"})
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", origin)
        self.send_header("Access-Control-Allow-Credentials", "true")
        self.send_header("Vary", "Origin")
        self.send_header("Access-Control-Allow-Methods", "GET, POST")
        self.send_header("Access-Control-Allow-Headers", "Authorization, Content-Type, X-Archimet")
        self.send_header("Access-Control-Max-Age", "600")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self):
        origin = self._origin()
        if origin is None:
            return self._send(403, {"error": "origin not allowed"})
        path = urllib.parse.urlsplit(self.path).path
        if path == "/archimet/health":
            return self._send(200, {"ok": True, "version": VERSION}, origin)
        try:
            if not self._authorized():
                return self._send(401, {"error": "Kismet login required"}, origin)
        except ConnectionError:
            return self._send(503, {"error": "Kismet is not answering"}, origin)
        if path == "/archimet/le_history.json":
            with self.logs.lock:
                return self._send(200, self.logs.history(), origin)
        if path == "/archimet/archive.json":
            q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            one = lambda k, d="": (q.get(k) or [d])[0]
            try:
                if one("tables"):
                    res = self.logs.archive_multi([t for t in one("tables").split(",") if t][:16], one("q")[:100],
                                                  int(one("page", "0")), int(one("length", "50")))
                else:
                    res = self.logs.archive(one("table", "ap"), one("q")[:100], int(one("page", "0")), int(one("length", "50")),
                                            one("sort"), one("dir", "desc") != "asc")
            except (KeyError, ValueError) as e:
                return self._send(400, {"error": "unknown table or bad paging", "detail": str(e)[:80]}, origin)
            return self._send(200, res, origin)
        if path == "/archimet/metrics.json":
            if not self.metrics:
                return self._send(503, {"error": "hardware metrics module not installed"}, origin)
            snap = self.metrics.collect(str(OUT), usage=self.sampler.usage)
            snap["events"] = self.sampler.history()
            snap["trend"] = self.sampler.trend_points()   # measured points only, from logger start
            return self._send(200, snap, origin)
        if path == "/archimet/state.json":
            q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            if q.get("rev", [""])[0] == self.logs.token():
                return self._send(200, {"rev": self.logs.token(), "unchanged": True,
                                        "logger": dict(self.status), "updated": ts(None)}, origin)
            st = self.logs.state()
            st["logger"] = dict(self.status)
            st["updated"] = ts(None)
            return self._send(200, st, origin)
        return self._send(404, {"error": "not found"}, origin)

    def do_POST(self):
        origin = self._origin()
        if origin is None:
            return self._send(403, {"error": "origin not allowed"})
        path = urllib.parse.urlsplit(self.path).path
        if path not in ("/archimet/mark", "/archimet/unmark", "/archimet/review", "/archimet/known.json"):
            return self._send(404, {"error": "not found"}, origin)
        # CSRF: a JSON body plus a custom header forces a CORS preflight, which only this
        # host's own pages pass (_origin). A browser-cookie request must also carry Origin.
        if self.headers.get("X-Archimet") != "1" or \
                not (self.headers.get("Content-Type") or "").startswith("application/json"):
            return self._send(400, {"error": "JSON with X-Archimet: 1 required"}, origin)
        if not origin and not (self.headers.get("Authorization") or "").startswith("Basic "):
            return self._send(403, {"error": "Origin required for browser requests"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if n < 0 or n > (16384 if path == "/archimet/known.json" else 4096):
            return self._send(413, {"error": "body too large"}, origin)
        raw = self.rfile.read(n) if n else b""
        try:
            if not self._authorized():
                return self._send(401, {"error": "Kismet login required"}, origin)
        except ConnectionError:
            return self._send(503, {"error": "Kismet is not answering"}, origin)
        try:
            req = json.loads(raw.decode("utf-8") or "{}")
        except (ValueError, UnicodeDecodeError):
            return self._send(400, {"error": "bad JSON"}, origin)
        if not isinstance(req, dict):
            return self._send(400, {"error": "bad JSON"}, origin)
        if path == "/archimet/known.json":
            macs = req.get("macs")
            if not isinstance(macs, list) or len(macs) > 500:
                return self._send(400, {"error": "macs must be a list of at most 500"}, origin)
            want = [m for m in (norm_mac(x) for x in macs) if MAC_RE.match(m)]
            return self._send(200, self.logs.known(want), origin)
        mac = norm_mac(req.get("mac"))
        if not MAC_RE.match(mac):
            return self._send(400, {"error": "mac must be 12 hex digits"}, origin)
        note = re.sub(r"[\x00-\x1f\x7f]+", " ", str(req.get("note") or "")).strip()
        action = req.get("action")
        if path == "/archimet/review" and action not in ("dismiss", "keep", "release"):
            return self._send(400, {"error": "action must be dismiss, keep or release"}, origin)
        if (path == "/archimet/mark" or (path == "/archimet/review" and action != "release")) and not (3 <= len(note) <= 500):
            return self._send(400, {"error": "note must be 3-500 characters"}, origin)
        if len(note) > 500:
            return self._send(400, {"error": "note too long"}, origin)
        ip = self.client_address[0]
        try:
            ipaddress.ip_address(ip)
        except ValueError:
            ip = "?"
        actor = "an authenticated Kismet UI user"
        try:
            if path == "/archimet/mark":
                res = self.logs.mark(mac, note, actor, ip, lambda m: fetch_mac(self.auth, m))
            elif path == "/archimet/review":
                res = self.logs.operator_resolve(mac, action, note, f"{actor} from {ip}")
            else:
                res = self.logs.unmark(mac, note, actor, ip)
        except sqlite3.Error as e:
            print(f"API write failed for {mac}: {e}", flush=True)
            return self._send(500, {"error": "database write failed; nothing was changed"}, origin)
        print(f"API {path.rsplit('/', 1)[1]} {mac} from {ip}: {res}", flush=True)
        return self._send(200, res, origin)


def load_metrics():
    """Hardware metrics module (archimet_metrics.py, installed beside this script)."""
    for d in (Path(__file__).resolve().parent, Path(ENV("ARCHIMET_LIB", "/usr/local/lib/archimet"))):
        if (d / "archimet_metrics.py").exists():
            sys.path.insert(0, str(d))
            break
    try:
        import archimet_metrics
    except ImportError:
        return None, None
    sampler = archimet_metrics.Sampler(OUT / "hardware_events.json")
    threading.Thread(target=sampler.run, name="archimet-hw", daemon=True).start()
    return archimet_metrics, sampler


def start_api(logs, status, auth):
    if HTTP_BIND.lower() == "off":
        return None
    host, _, port = HTTP_BIND.rpartition(":")
    Api.logs, Api.status, Api.auth = logs, status, auth
    Api.metrics, Api.sampler = load_metrics()
    srv = ThreadingHTTPServer((host or "0.0.0.0", int(port)), Api)
    srv.daemon_threads = True
    t = threading.Thread(target=srv.serve_forever, name="archimet-api", daemon=True)
    t.start()
    print(f"Archimet API on {HTTP_BIND}", flush=True)
    return srv


