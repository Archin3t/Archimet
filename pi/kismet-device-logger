def load_rules_or_keep(current, mtime):
    """Reload the rules if the file changed. A bad file keeps the last good rules."""
    try:
        m = RULES_PATH.stat().st_mtime
    except OSError:
        if current is None:
            print(f"Rules file {RULES_PATH} missing: logging APs/clients only, no LE classification", flush=True)
            return Rules(), None
        return current, mtime
    if current is not None and m == mtime:
        return current, mtime
    try:
        r = Rules.load(RULES_PATH)
        print(f"Rules {r.version} loaded from {RULES_PATH} ({len(r.prefix)} prefixes)", flush=True)
        return r, m
    except (OSError, ValueError, re.error) as exc:
        print(f"Rules file {RULES_PATH} rejected ({exc}); keeping {current.version if current else 'none'}", flush=True)
        return current or Rules(), m


def run(stop=None):
    """The service loop. `stop` (a threading.Event) ends it cleanly; the service never sets it."""
    rules, mtime = load_rules_or_keep(None, None)
    logs = Logs(rules)
    auth = credentials()
    status = {"version": VERSION, "started": ts(None), "poll_seconds": POLL_SECONDS,
              "last_poll": "", "last_poll_ok": "", "last_poll_ms": 0, "last_poll_devices": 0,
              "new_device_delay": {}, "events": []}
    srv = start_api(logs, status, auth)
    try:
        _loop(logs, status, auth, mtime, stop)
    finally:
        if srv:
            srv.shutdown()
            srv.server_close()
        logs.close()


def _loop(logs, status, auth, mtime, stop):
    delays = collections.deque(maxlen=500)
    since = 0  # first pass after (re)start: everything Kismet currently knows
    prev = 0
    pending = {}       # (MAC, PHY, log role) -> newest record, written to the AP/client logs every LOG_FLUSH_SECONDS
    flushed = 0
    print(f"Logging to {OUT} every {POLL_SECONDS:g}s", flush=True)
    if PUBLIC_HISTORY.exists():
        print(f"WARNING: {PUBLIC_HISTORY} exists and Kismet serves it without a login; "
              "LE History is served by the API now, remove the file", flush=True)
    while not (stop and stop.is_set()):
        started = time.time()
        auth = refresh_credentials(auth)
        rules2, mtime = load_rules_or_keep(logs.rules, mtime)
        if rules2 is not logs.rules:
            logs.rules = rules2
        try:
            devices = fetch(auth, since)
            parsed = [d for d in (parse(x) for x in devices) if not quarantined(d, logs.out)]
            for d in parsed:
                keep_newer(pending, d)
            merged = merge_by_mac(parsed)      # one record per MAC for LE / Review
            flush = started - flushed >= LOG_FLUSH_SECONDS
            with logs.lock:
                try:
                    changed = sum(logs.classify(d) for d in merged)
                    changed += logs.learn(merged, lambda m: fetch_mac(auth, m))
                    if started - logs.resolved_at >= REVIEW_RESOLVE_SECONDS:
                        changed += logs.resolve_review(started)
                    if flush:
                        changed += flush_pending(logs, pending)
                    logs.commit()
                except Exception:
                    logs.rollback()
                    raise
            if flush:
                pending.clear()
                flushed = started
            now = time.time()
            if prev:
                for d in parsed:
                    if d["first"] and d["first"] > prev - 1:
                        delays.append(now - d["first"])
            if delays:
                s = sorted(delays)
                status["new_device_delay"] = {"n": len(s), "p50": round(s[len(s) // 2], 2),
                                              "p95": round(s[int(len(s) * 0.95) - 1 if len(s) > 1 else 0], 2),
                                              "max": round(s[-1], 2)}
            status["events"] = [dict(e, delay=round(e["at"] - e["seen"], 2) if e["seen"] else None)
                                for e in list(logs.events)[-20:]]
            status.update(last_poll=ts(started), last_poll_ok=ts(now),
                          last_poll_ms=int((now - started) * 1000), last_poll_devices=len(devices))
            since = started - OVERLAP
            prev = started
            if changed:
                print(f"{len(devices)} active, {changed} rows written", flush=True)
        except Exception as exc:  # Kismet restarting, etc. -- retry next round
            print(f"Poll failed: {exc}", flush=True)
            status["last_poll"] = ts(started)
            since = 0      # pending records are kept and written at the next successful flush
            prev = 0
        delay = max(0.5, POLL_SECONDS - (time.time() - started))
        if stop:
            stop.wait(delay)
        else:
            time.sleep(delay)


def import_inventory(path):
    rules, _ = load_rules_or_keep(None, None)
    logs = Logs(rules)
    src = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    n = changed = 0
    for mac, first, last, blob in src.execute(
            "SELECT mac, first_seen, last_seen, latest_json FROM inventory"):
        try:
            dev = json.loads(blob or "{}")
        except ValueError:
            continue
        d = parse(dev)
        d["mac"] = d["mac"] or (mac or "").upper()
        d["first"] = first or d["first"]
        d["last"] = last or d["last"]
        changed += logs.record(d)
        n += 1
    logs.commit()
    logs.close()
    src.close()
    print(f"Imported {n} devices ({changed} rows written)")


