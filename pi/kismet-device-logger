# One-time migration of pre-Archimet LE rows

def migrate(confirm_macs, confirm_note, dry_run=False):
    rules, _ = load_rules_or_keep(None, None)
    if not rules.prefix:
        sys.exit("refusing to migrate without a valid rules file")
    logs = Logs(rules)
    run_id = time.strftime("%Y%m%d-%H%M%S")
    report = {"run": run_id, "before": {}, "after": {}, "actions": []}
    le = logs.le
    rows = logs.le_rows()
    report["before"] = {"le_rows": len(rows),
                        "review_rows": le.execute("SELECT COUNT(*) FROM rv.review").fetchone()[0],
                        "by_kind": dict(collections.Counter(kind_of(r["match_reason"]) for r in rows))}
    now = ts(None)

    def log(mac, action, before, after):
        report["actions"].append({"mac": mac, "action": action,
                                  "before": before and before["match_reason"],
                                  "after": after and after.get("match_reason", after.get("why_might_be"))})
        le.execute("INSERT INTO rv.migration (at, run, mac, action, before_json, after_json) VALUES (?,?,?,?,?,?)",
                   (now, run_id, mac, action, json.dumps(before), json.dumps(after)))

    try:
        for r in rows:
            k = kind_of(r["match_reason"])
            if k in ("hardware", "operator", "learned") and r["match_reason"].split(":", 1)[0] in ("Hardware", "Operator", "Learned"):
                continue   # already in the new format
            d = {"mac": r["mac"], "type": r["type"] or "", "name": r["name"] or "", "ssid": r["name"] or "",
                 "manuf": r["manufacturer"] or "", "crypt": r["encryption"] or "",
                 "phy": "BTLE" if r["radio"] == "Bluetooth" else "IEEE802.11",
                 "first": 0, "last": 0, "uuids": []}
            sigs = rules.signals(d)
            hw, reason = rules.hardware(sigs)
            if hw and k == "hardware":
                after = dict(r, category=rules.log_category(hw["category"]), match_reason=reason)
                le.execute("UPDATE law_enforcement SET category=?, match_reason=? WHERE mac=?",
                           (after["category"], reason, r["mac"]))
                log(r["mac"], "hardware-reason-rewritten", r, after)
                continue
            if r["mac"] in confirm_macs and k == "hardware":
                fleet = [s for s in sigs if s["class"] == "fleet"]
                ev = "; ".join(f"{s['detail']} (fleet vendor: also sold for non-police use)" for s in fleet) or r["match_reason"]
                reason = (f"Operator: confirmed by the operator (migration {run_id}). Note: {confirm_note} "
                          f"| Hardware evidence: {ev}")
                le.execute("INSERT OR REPLACE INTO rv.overrides (mac, note, actor, source_ip, created, name, manufacturer, radio, type)"
                           " VALUES (?,?,?,?,?,?,?,?,?)",
                           (r["mac"], confirm_note, "migration", "local", now, r["name"], r["manufacturer"], r["radio"], r["type"]))
                after = dict(r, match_reason=reason)
                le.execute("UPDATE law_enforcement SET match_reason=? WHERE mac=?", (reason, r["mac"]))
                log(r["mac"], "operator-confirmed", r, after)
                continue
            # Keyword-only rows, and hardware rows the new rules no longer accept.
            review = [s for s in sigs if s["class"] in ("fleet", "name", "laa", "agency")]
            review.append({"kind": "legacy-le-row", "class": "legacy",
                           "detail": f"was in law_enforcement.sqlite as “{r['category']}”: {r['match_reason']}"})
            d["first"] = time.mktime(time.strptime(r["first_seen"], "%Y-%m-%d %H:%M:%S")) if r["first_seen"] else 0
            d["last"] = time.mktime(time.strptime(r["last_seen"], "%Y-%m-%d")) if r["last_seen"] else 0
            logs.review_upsert(d, review, source="migration")
            rv = logs._get("rv", "rv.review", r["mac"])
            le.execute("UPDATE rv.review SET status='open', first_seen=?, last_seen=? WHERE mac=?",
                       (min(rv["first_seen"], r["first_seen"] or rv["first_seen"]), r["last_seen"] or rv["last_seen"], r["mac"]))
            le.execute("DELETE FROM law_enforcement WHERE mac=?", (r["mac"],))
            log(r["mac"], "moved-to-review", r, logs._get("rv", "rv.review", r["mac"]))
        rows2 = logs.le_rows()
        report["after"] = {"le_rows": len(rows2),
                           "review_rows": le.execute("SELECT COUNT(*) FROM rv.review").fetchone()[0],
                           "by_kind": dict(collections.Counter(kind_of(r["match_reason"]) for r in rows2))}
        if dry_run:
            logs.rollback()
            report["dry_run"] = True
        else:
            logs.le_dirty = True
            logs.commit()
    except Exception:
        logs.rollback()
        raise
    finally:
        logs.close()
    print(json.dumps(report, indent=1))
    return report


def rollback_migration(run_id=None):
    logs = Logs(Rules())
    le = logs.le
    q = "SELECT id, run, mac, action, before_json, after_json FROM rv.migration WHERE reverted IS NULL"
    args = ()
    if run_id:
        q += " AND run=?"
        args = (run_id,)
    rows = le.execute(q + " ORDER BY id DESC", args).fetchall()
    try:
        for mid, run, mac, action, before, after in rows:
            b = json.loads(before)
            cols = ", ".join(b)
            le.execute(f"INSERT OR REPLACE INTO law_enforcement ({cols}) VALUES ({', '.join('?' * len(b))})", list(b.values()))
            if action == "moved-to-review":
                le.execute("DELETE FROM rv.review WHERE mac=? AND source='migration'", (mac,))
            if action == "operator-confirmed":
                le.execute("DELETE FROM rv.overrides WHERE mac=? AND actor='migration'", (mac,))
            le.execute("UPDATE rv.migration SET reverted=? WHERE id=?", (ts(None), mid))
        logs.le_dirty = True
        logs.commit()
    except Exception:
        logs.rollback()
        raise
    finally:
        logs.close()
    print(f"Reverted {len(rows)} migration actions")


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--import-inventory", metavar="PATH")
    ap.add_argument("--migrate", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--confirm-operator", default="", help="comma-separated MACs carried over as Operator rows")
    ap.add_argument("--confirm-note", default="")
    ap.add_argument("--rollback-migration", nargs="?", const="", metavar="RUN")
    ap.add_argument("--check-rules", metavar="PATH")
    ap.add_argument("--repair-unmarked", action="store_true", help="put earlier unmarked devices into Review (watched)")
    ap.add_argument("--refresh-review-notes", action="store_true", help="recompute Review notes from their signals")
    ap.add_argument("--audit-learned", action="store_true", help="move Learned rows without data-frame evidence to Review")
    args = ap.parse_args()
    if args.check_rules:
        r = Rules.load(args.check_rules)
        print(f"ok {r.version} sha256={r.sha} prefixes={len(r.prefix)} names={len(r.names)}")
    elif args.repair_unmarked:
        rules, _ = load_rules_or_keep(None, None)
        print(f"{Logs(rules).repair_unmarked()} unmarked devices put back into Review (watched)")
    elif args.audit_learned:
        rules, _ = load_rules_or_keep(None, None)
        moved = Logs(rules).audit_learned()
        print(f"{len(moved)} Learned rows without data-frame evidence moved to Review: {moved}")
    elif args.refresh_review_notes:
        rules, _ = load_rules_or_keep(None, None)
        print(f"{Logs(rules).refresh_review_notes()} Review rows' notes refreshed")
    elif args.import_inventory:
        import_inventory(args.import_inventory)
    elif args.migrate:
        macs = {norm_mac(m) for m in args.confirm_operator.split(",") if m.strip()}
        if macs and not args.confirm_note.strip():
            sys.exit("--confirm-operator needs --confirm-note")
        migrate(macs, args.confirm_note.strip(), args.dry_run)
    elif args.rollback_migration is not None:
        rollback_migration(args.rollback_migration or None)
    else:
        run()
