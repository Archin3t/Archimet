# ---- Review resolution policy. Versioned: every decision records the version that made it.
# States: active (needs a person), deprioritized (kept, lower in the list, no notices), dismissed
# (out of the Review list, no notices, reopened automatically by new evidence).
# Never automatic: promotion to LE (only the vendor-ID rules and an operator do that), and any
# row an operator watches, unmarked, or decided on (locked).
REVIEW_POLICY = "review-policy 1"
REVIEW_WEAK = {"agency", "legacy-le-row", "probe-confirmed-ssid", "probed-by-confirmed", "adjacent-mac",
               "shared-ap", "parent-full"}            # can never confirm LE on their own
REVIEW_DISMISSIBLE = {"agency", "legacy-le-row"}       # a typed word (and its old keyword row), nothing else
REVIEW_OPERATOR = {"operator-unmarked"}
REVIEW_STALE_DAYS = 30
REVIEW_RESOLVE_SECONDS = 60


def review_decision(rules, row, last_obs, now):
    """Decision for one open Review row, or None when it is operator territory (watched or unmarked).
    row: the rv.review row (signals as a list); last_obs: newest real observation (epoch) or 0.
    -> (state, rule, observed, why, unknown, basis)"""
    sigs = row.get("signals") or []
    kinds = sorted({s.get("kind") or s.get("class") or "?" for s in sigs})
    if any(s.get("watch") for s in sigs) or set(kinds) & REVIEW_OPERATOR:
        return None
    basis = json.dumps({"kinds": kinds}, sort_keys=True)
    name, manuf = row.get("name") or "", row.get("manufacturer") or ""
    words = sorted({s.get("word") for s in sigs if s.get("class") == "agency" and s.get("word")})
    consumer = rules.consumer_radio(manuf)
    days = int((now - last_obs) // 86400) if last_obs else None
    weak = bool(kinds) and set(kinds) <= REVIEW_WEAK
    # Dismissal needs evidence that contradicts the signals, not merely weak signals: a public /
    # ISP hotspot name is shared by many users and cannot identify one agency's equipment.
    if weak and name.strip().lower() in rules.public:
        return ("dismissed", "public-hotspot",
                f"Network name “{name}” is a public / ISP hotspot name (rules: public_ssids); signals: {', '.join(kinds)}.",
                "A public hotspot is used by many people and devices, so an LE-log device joining it, or a word near "
                "it, says nothing about who runs it.",
                "Nothing further is needed. A vendor MAC prefix or a model name on this device would reopen it.", basis)
    # A typed agency word on a consumer maker's radio: weak, but ownership is NOT disproved (an agency
    # can run a consumer router), so it is only de-prioritised. Equipment type and LE ownership are
    # separate questions.
    if kinds and set(kinds) <= REVIEW_DISMISSIBLE and consumer:
        return ("deprioritized", "consumer-radio-agency-word",
                f"Agency word {', '.join('“%s”' % w for w in words) or '(old keyword row)'} in the network name “{name}”; "
                f"Kismet's manufacturer lookup gives “{manuf}”, a consumer radio maker.",
                "The only positive signal is a word anyone can type into a network name, on consumer hardware. That is "
                "not evidence of LE equipment, but it does not prove the network is unrelated to an agency either.",
                "Who runs this network. A fleet or LE vendor MAC prefix, an LE model name, or a data-frame link to a "
                "LE-log device would make it active again.", basis)
    if weak:
        return ("deprioritized", "weak-only",
                "Signals: " + ", ".join(kinds) + (f" (word {', '.join(words)})" if words else "") + (f"; manufacturer “{manuf}”" if manuf else ""),
                "Only signals that can never confirm LE on their own (a typed word, a probe, an adjacent MAC, a shared AP).",
                "Whether it is LE equipment at all. A vendor MAC prefix, a model name or a data-frame link to an LE-log device "
                "would make it active again.", basis)
    if days is not None and days > REVIEW_STALE_DAYS:
        return ("deprioritized", "stale",
                f"Signals: {', '.join(kinds)}; last observed {days} days ago.",
                f"Not observed for more than {REVIEW_STALE_DAYS} days. It becomes active again when it is heard again.",
                "Whether it is still in use.", basis)
    return ("active", "needs-review", "Signals: " + ", ".join(kinds or ["none"]),
            "At least one signal needs a person to judge it (fleet vendor MAC, model name, unconfirmed link).",
            "Whether it is LE equipment.", basis)


def ts(epoch):
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(epoch or time.time()))


def day(epoch):
    return time.strftime("%Y-%m-%d", time.localtime(epoch or time.time()))


def randomized(mac):
    try:
        return int(int(mac.split(":")[0], 16) & 0x02 != 0)
    except (ValueError, IndexError):
        return 0


def merge_list(old, new):
    items = [x for x in (old or "").split(", ") if x]
    for x in new:
        if x and x not in items:
            items.append(x)
    return ", ".join(items)


def norm_mac(s):
    """'02-00-00-ab-cd-ef', '020000ABCDEF', '02:00:00:ab:cd:ef' -> '02:00:00:AB:CD:EF'."""
    h = re.sub(r"[^0-9A-Fa-f]", "", str(s or "")).upper()
    if len(h) != 12:
        return ""
    return ":".join(h[i:i + 2] for i in range(0, 12, 2))


def hexmac(mac):
    return re.sub(r"[^0-9A-F]", "", (mac or "").upper())


def radio_of(phy):
    p = (phy or "").lower()
    return "Bluetooth" if "bluetooth" in p or "btle" in p else "Wi-Fi"


def kind_of(reason):
    """Which evidence produced an LE row. Pre-Archimet rows are recognised too."""
    r = (reason or "").strip()
    if r.startswith("Hardware:"):
        return "hardware"
    if r.startswith("Operator:"):
        return "operator"
    if r.startswith("Learned:"):
        return "learned"
    parts = [p.strip().split(":", 1)[0] for p in r.split(";") if p.strip()]
    if any(p in ("mac prefix", "manufacturer", "ble service") for p in parts):
        return "hardware"
    return "keyword" if parts else ""


# Stored reasons name the parent as "LE-log AP/device <MAC>" (logger 5.3) or "confirmed LE AP/device <MAC>" (older rows).
# An Origin header as browsers send it: scheme://host[:port], printable, no path, no control characters.
ORIGIN_RE = re.compile(r"https?://(?:[A-Za-z0-9.-]{1,253}|\[[0-9A-Fa-f:.]{2,45}\])(?::[0-9]{1,5})?")
PARENT_RE = re.compile(r"(?:confirmed LE|LE-log) (?:AP|device) ([0-9A-F]{2}(?::[0-9A-F]{2}){5})")


def parent_of(reason):
    m = PARENT_RE.search(reason or "")
    return m.group(1) if m else ""


def _values(v):
    if isinstance(v, dict):
        return list(v.values())
    return v if isinstance(v, list) else []


def parse(dev):
    """Flatten a Kismet device record (full or slim field list) into the fields we keep."""
    g = lambda k, d="": dev.get("kismet.device.base." + k, d) or d
    dot11 = dev.get("dot11.device") or {}
    if not isinstance(dot11, dict):
        dot11 = {}
    dg = lambda k: dot11.get(k) if dot11.get(k) is not None else dev.get(k)
    mac = g("macaddr").upper()
    name = g("commonname") or g("name")
    if name.upper() == mac:
        name = ""
    beacon = dg("dot11.device.last_beaconed_ssid_record") or {}
    ssid = beacon.get("dot11.advertisedssid.ssid", "") if isinstance(beacon, dict) else ""
    ssid = ssid or dev.get("dot11.advertisedssid.ssid") or ""
    if not ssid:
        for rec in _values(dg("dot11.device.advertised_ssid_map")):
            if isinstance(rec, dict) and rec.get("dot11.advertisedssid.ssid"):
                ssid = rec["dot11.advertisedssid.ssid"]
                break
    probe_recs = [p for p in _values(dg("dot11.device.probed_ssid_map")) if isinstance(p, dict)]
    probed = sorted({p.get("dot11.probedssid.ssid", "") for p in probe_recs} - {""})
    probe_bssids = sorted({(p.get("dot11.probedssid.bssid") or "").upper() for p in probe_recs} - NULL_MACS)
    bssid = (dg("dot11.device.last_bssid") or "").upper()
    if bssid in NULL_MACS or bssid == mac:
        bssid = ""
    # Kismet's association records: per BSSID, with first/last frame time.
    # Kismet's per-BSSID client records. Management frames (incl. directed probes and
    # auth/assoc *requests*) create them too; the retry/fragment/DHCP/EAP/CDP/IP fields
    # are only filled by data frames, which need a completed association.
    assoc_to = {}
    for b, rec in (dg("dot11.device.client_map") or {}).items():
        b = (b or "").upper()
        if b in NULL_MACS or b == mac or not isinstance(rec, dict):
            continue
        assoc_to[b] = assoc_record(rec)
    assoc_clients = sorted({(k or "").upper() for k in (dg("dot11.device.associated_client_map") or {})}
                           - NULL_MACS - {mac})
    bt = dev.get("bluetooth.device") or {}
    uuids = (bt.get("bluetooth.device.service_uuid_vec") if isinstance(bt, dict) else None) \
        or dev.get("bluetooth.device.service_uuid_vec") or []
    return {
        "mac": mac,
        "key": str(dev.get("kismet.device.base.key") or ""),
        "type": g("type"),
        "phy": g("phyname"),
        "name": name,
        "ssid": ssid,
        "manuf": g("manuf"),
        "crypt": g("crypt"),
        "channel": str(g("channel")),
        "first": g("first_time", 0),
        "last": g("last_time", 0),
        "probed": probed,
        "bssid": bssid,
        "assoc_to": assoc_to,
        "assoc_clients": assoc_clients,
        "probe_bssids": probe_bssids,
        "uuids": [str(u).upper() for u in uuids],
    }


DATA_ONLY_FIELDS = ("dot11.client.dhcp_host", "dot11.client.dhcp_vendor", "dot11.client.eap_identity",
                    "dot11.client.cdp_device", "dot11.client.cdp_port", "dot11.client.ipdata")


def assoc_record(rec):
    """One Kismet client record, with the data-frame evidence it carries (if any)."""
    retries = int(rec.get("dot11.client.num_retries") or 0)
    frags = int(rec.get("dot11.client.num_fragments") or 0)
    rbytes = int(rec.get("dot11.client.datasize_retry") or 0)
    extra = [k.split(".")[-1] for k in DATA_ONLY_FIELDS if rec.get(k) not in (None, "", 0, {}, [])]
    ev = []
    if retries:
        ev.append(f"{retries} retried data frames")
    if frags:
        ev.append(f"{frags} fragmented data frames")
    if rbytes and not retries:
        ev.append(f"{rbytes} retried data bytes")
    if extra:
        ev.append("data-frame metadata " + "/".join(extra))
    return {"first": rec.get("dot11.client.first_time") or 0, "last": rec.get("dot11.client.last_time") or 0,
            "data": bool(ev), "evidence": ", ".join(ev)}


def role_rank(d):
    """Which of several Kismet records for one MAC defines its role: AP, then Wi-Fi client, then
    other 802.11, then Bluetooth, then anything else. Lower is stronger."""
    if d["phy"] == "IEEE802.11":
        return 0 if d["type"] in AP_TYPES else 1 if d["type"] in CLIENT_TYPES else 2
    return 3 if radio_of(d["phy"]) == "Bluetooth" else 4


def merge_by_mac(records):
    """Kismet keys devices by phy + MAC, so one MAC can come back as several records (e.g. a
    Wi-Fi AP and a Bluetooth advertiser). Returns one record per MAC for classification: the role
    of the strongest record (role_rank), the newest last_time and earliest first_time of all of
    them, and the union of their probe / association / UUID evidence. Nothing is invented."""
    groups = {}
    for d in records:
        if d["mac"]:
            groups.setdefault(d["mac"], []).append(d)
    out = []
    for mac, recs in groups.items():
        if len(recs) == 1:
            out.append(recs[0])
            continue
        recs = sorted(recs, key=lambda r: (role_rank(r), -(r["last"] or 0)))
        m = dict(recs[0])
        m["last"] = max(r["last"] or 0 for r in recs)
        firsts = [r["first"] for r in recs if r["first"]]
        m["first"] = min(firsts) if firsts else 0
        for k in ("ssid", "name", "manuf", "crypt", "bssid"):
            m[k] = m[k] or next((r[k] for r in recs if r[k]), "")
        for k in ("probed", "assoc_clients", "probe_bssids", "uuids"):
            m[k] = sorted({x for r in recs for x in r[k]})
        m["assoc_to"] = {}
        for r in reversed(recs):          # the strongest record's entry wins a tie
            m["assoc_to"].update(r["assoc_to"])
        m["records"] = [f'{r["phy"]}/{r["type"]}' for r in recs]
        out.append(m)
    return out


def kept_role(old, d):
    """(radio, type) for an LE / Review row. A poll may return only a weaker record for a MAC
    (e.g. its Bluetooth side while the Wi-Fi AP record is idle): the stronger role already
    logged is kept."""
    radio, dtype = radio_of(d.get("phy")), d.get("type") or ""
    if old and old.get("type"):
        was = {"phy": "IEEE802.11" if old.get("radio") == "Wi-Fi" else old.get("radio") or "", "type": old["type"]}
        if role_rank(was) < role_rank({"phy": d.get("phy") or "", "type": dtype}):
            return old.get("radio") or radio, old["type"]
    return radio, dtype


def log_role(d):
    """Which AP/client log a record belongs in: "ap", "client", or None (not logged there:
    other PHYs, other 802.11 types, randomized client MACs)."""
    if d.get("phy") != "IEEE802.11" or not d.get("mac"):
        return None
    if d.get("type") in AP_TYPES:
        return "ap"
    if d.get("type") in CLIENT_TYPES and not randomized(d["mac"]):
        return "client"
    return None


def pending_key(d):
    """Key for the AP/client write buffer, or None if log_device would write nothing for it.
    (MAC, PHY, log role): not Kismet's device key, which is per phy + MAC and does not change
    when Kismet re-types a device, so an AP reading and a later client reading of one MAC
    would share a slot and one log would lose its row; and a missing or reused key must
    never let one MAC's reading replace another's."""
    role = log_role(d)
    return (d["mac"], d["phy"], role) if role else None


def keep_newer(buf, d):
    """Buffer a record unless the buffer already holds a newer reading of the same record."""
    k = pending_key(d)
    if k is None:
        return
    old = buf.get(k)
    if old is None or (d["last"] or 0) >= (old["last"] or 0):
        buf[k] = d


def flush_pending(logs, buf):
    """Write every buffered record to the AP/client logs. The caller commits and clears."""
    return sum(logs.log_device(d) for d in buf.values())


