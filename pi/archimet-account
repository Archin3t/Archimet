"""Archimet account (Kismet's own single login) from the Pi's command line.

    archimet-account status        is setup finished? (never prints a credential)
    sudo archimet-account reset    forgotten password: back to archimet / archimet and SETUP mode

reset keeps a copy of the old login file (<file>.before-reset-<time>, mode 600), writes the default
account, and restarts Kismet and the gateway. The Pi is then closed to the network again until the
default password is changed (from this Pi or through an SSH tunnel). Names, notes and logs are kept.
"""
import base64
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

DEFAULTS = "/etc/default/archimet"


def env():
    out = {}
    try:
        for line in open(DEFAULTS):
            m = re.match(r"^([A-Z_]+)=(.*)$", line.strip())
            if m:
                out[m.group(1)] = m.group(2)
    except OSError:
        pass
    return out


def code(url, auth=None):
    h = {"Authorization": "Basic " + base64.b64encode(auth.encode()).decode()} if auth else {}
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=h), timeout=10) as r:
            return r.status
    except urllib.error.HTTPError as e:
        e.close()
        return e.code
    except OSError:
        return 0


def status(e):
    k = e.get("ARCHIMET_API", "http://127.0.0.1:2500")
    s = code(k + "/session/check_setup_ok")
    if s == 0:
        print("Kismet is not answering; state unknown.")
        return 1
    if s == 500:
        print("No account yet: setup not finished (Archimet is closed to the network).")
        return 1
    if code(k + "/session/check_session", "archimet:archimet") == 200:
        print("Setup NOT finished: the default password is still active (Archimet is closed to the network).")
        return 1
    print("Setup finished: an account with a non-default password exists.")
    return 0


def reset(e):
    creds = e.get("ARCHIMET_CREDS")
    user = e.get("ARCHIMET_USER")
    if not creds or not user:
        sys.exit(f"{DEFAULTS} does not name ARCHIMET_CREDS / ARCHIMET_USER")
    subprocess.run(["systemctl", "stop", "kismet.service"], check=False)
    if os.path.exists(creds):
        keep = f"{creds}.before-reset-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(creds, keep)
        os.chmod(keep, 0o600)
        lines = [l for l in open(creds) if not l.startswith(("httpd_username=", "httpd_password="))]
    else:
        keep, lines = None, []
    os.makedirs(os.path.dirname(creds), mode=0o700, exist_ok=True)
    with open(creds, "w") as f:
        f.writelines(lines + ["httpd_username=archimet\n", "httpd_password=archimet\n"])
    os.chmod(creds, 0o600)
    shutil.chown(creds, user, user)
    subprocess.run(["systemctl", "start", "kismet.service"], check=False)
    subprocess.run(["systemctl", "restart", "archimet-gateway.service"], check=False)   # ends every session
    print("Account reset to the default. Archimet is closed to the network until you change the password:")
    print("  from your computer: ssh -L 2501:127.0.0.1:2501 <user>@<this Pi>, then https://localhost:2501/")
    if keep:
        print(f"Old login file kept (private): {keep}")


def main():
    cmd = (sys.argv[1:] or ["status"])[0]
    e = env()
    if cmd == "status":
        sys.exit(status(e))
    if cmd == "reset":
        if os.geteuid() != 0:
            sys.exit("run as root: sudo archimet-account reset")
        reset(e)
        return
    sys.exit(__doc__)


if __name__ == "__main__":
    main()
