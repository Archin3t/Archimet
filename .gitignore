# Allowlist: nothing is tracked unless it is listed here. Private material (preview/,
# reference/, local/, backups/: real device snapshots, databases, logs, credentials) and any
# new file stay out until they are reviewed and added below.
/*
!/.gitignore
!/README.md
!/NOTICE.md
!/LICENSE
!/SECURITY.md

!/ui/

!/pi/
/pi/*
!/pi/kismet-device-logger
!/pi/archimet_metrics.py
!/pi/archimet-compat
!/pi/archimet-setup
!/pi/archimet-gateway
!/pi/archimet-hold
!/pi/archimet-selftest
!/pi/archimet-tls
!/pi/archimet-account

!/shared/
/shared/*
!/shared/le_rules.json

!/packaging/

!/tools/
/tools/*
!/tools/package.py

!/tests/
/tests/*
!/tests/test_ui.mjs
!/tests/test_gateway.py
!/tests/test_resize.mjs
!/tests/test_logger.py
!/tests/test_compat.py
!/tests/test_credentials_reload.py
!/tests/test_setup.py

!/docs/
/docs/*
!/docs/UPDATES.md
!/docs/SECURITY.md
!/docs/INSTALL.md
!/docs/HTTPS.md
!/docs/HOTSPOT.md
!/docs/DATA.md
!/docs/RECOVERY.md
!/docs/FEATURES.md
!/docs/COMPARISON.md
!/docs/STATUS.md
!/docs/HOW-IT-WORKS.md
!/docs/LE-DETECTION.md
!/docs/REPOSITORY.md
!/docs/HARDWARE.md
!/docs/USER-GUIDE.md
!/docs/CONFIGURATION.md
!/docs/FAQ.md
!/docs/intro.gif

__pycache__/
*.pyc
