{
 "contract": 1,
 "tested_with": "Kismet 2025.09.0",
 "logger": {"path": "/archimet/health", "name": "archimet-logger", "min_version": "5.2.0"},
 "endpoints": [
  {"id": "status", "screen": "System, status strip", "method": "GET", "path": "/system/status.json",
   "requires": ["kismet.system.version", "kismet.system.devices.count", "kismet.system.timestamp.sec", "kismet.system.timestamp.start_sec", "kismet.system.memory.rss", "kismet.system.memory.rrd", "kismet.system.devices.rrd", "kismet.system.sensors.temp", "kismet.system.server_name"]},
  {"id": "views", "screen": "Devices (view control)", "method": "GET", "path": "/devices/views/all_views.json",
   "list": true, "item_requires_if_any": ["kismet.devices.view.id", "kismet.devices.view.description", "kismet.devices.view.size"]},
  {"id": "devices", "screen": "Devices (list)", "method": "POST", "path": "/devices/views/all/devices.json",
   "form": {"json": "{\"fields\":[\"kismet.device.base.key\",\"kismet.device.base.macaddr\",\"kismet.device.base.last_time\"]}", "page": "0", "length": "1"},
   "requires": ["data", "last_row", "last_page"], "item": ["data", 0], "item_requires": ["kismet.device.base.key", "kismet.device.base.macaddr", "kismet.device.base.last_time"],
   "max_items": ["data", 1], "max_fields": 3},
  {"id": "alerts", "screen": "Alerts", "method": "GET", "path": "/alerts/last-time/0/alerts.json", "list": true,
   "item_requires_if_any": ["kismet.alert.header", "kismet.alert.text", "kismet.alert.timestamp", "kismet.alert.severity"]},
  {"id": "alert_defs", "screen": "Alerts (definitions)", "method": "GET", "path": "/alerts/definitions.json", "list": true,
   "item_requires_if_any": ["kismet.alert.definition.header", "kismet.alert.definition.description", "kismet.alert.definition.severity"]},
  {"id": "messages", "screen": "Messages", "method": "GET", "path": "/messagebus/last-time/0/messages.json",
   "requires": ["kismet.messagebus.list", "kismet.messagebus.timestamp"]},
  {"id": "sources", "screen": "Sources", "method": "GET", "path": "/datasource/all_sources.json", "list": true,
   "item_requires_if_any": ["kismet.datasource.name", "kismet.datasource.uuid", "kismet.datasource.running", "kismet.datasource.hopping", "kismet.datasource.channel", "kismet.datasource.packets_rrd"]},
  {"id": "source_types", "screen": "Sources (drivers)", "method": "GET", "path": "/datasource/types.json", "list": true},
  {"id": "channels", "screen": "Channels", "method": "GET", "path": "/channels/channels.json",
   "requires": ["kismet.channeltracker.frequency_map"]},
  {"id": "gps", "screen": "Status strip, System", "method": "GET", "path": "/gps/location.json"},
  {"id": "packets", "screen": "System (packet rates)", "method": "GET", "path": "/packetchain/packet_stats.json",
   "requires": ["kismet.packetchain.packets_rrd", "kismet.packetchain.dropped_packets_rrd", "kismet.packetchain.error_packets_rrd"]},
  {"id": "phys", "screen": "System (PHYs)", "method": "GET", "path": "/phy/all_phys.json", "list": true},
  {"id": "plugins", "screen": "System (plugins)", "method": "GET", "path": "/plugins/all_plugins.json", "list": true},
  {"id": "ssids", "screen": "SSIDs", "method": "POST", "path": "/phy/phy80211/ssids/views/ssids.json",
   "form": {"json": "{}", "page": "0", "length": "1"}, "requires": ["data", "last_row"]},
  {"id": "apikeys", "screen": "Settings › Account", "method": "GET", "path": "/auth/apikey/list.json", "list": true},
  {"id": "session", "screen": "Login", "method": "GET", "path": "/session/check_session", "text": true}
 ]
}
